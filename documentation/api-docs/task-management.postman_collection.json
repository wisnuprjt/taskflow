{
  "info": {
    "name": "Task Management API",
    "description": "Laravel REST API. Run **Auth / Login** first: its test script stores the JWT in the `token` collection variable, which every other request uses as Bearer auth.\n\nErrors are always JSON `{ message, errors? }` with 401 / 403 / 404 / 422 status codes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "task_id",
      "value": "1"
    },
    {
      "key": "attachment_id",
      "value": "1"
    },
    {
      "key": "upload_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns `access_token` (JWT), `token_type`, `expires_in` (seconds) and `user`. 401 on wrong credentials, 422 on invalid input. Rate limited to 10/min."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.collectionVariables.set('token', body.access_token);",
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Invalidates (blacklists) the current token."
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "1-50, default 15"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "todo | in_progress | done",
                  "disabled": true
                },
                {
                  "key": "priority",
                  "value": "",
                  "description": "low | medium | high",
                  "disabled": true
                },
                {
                  "key": "assigned_user_id",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "matches title",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "-created_at",
                  "description": "created_at | due_date | priority | title, prefix '-' for desc"
                }
              ]
            }
          }
        },
        {
          "name": "Get task",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}"
              ]
            },
            "description": "Includes assignee, creator, attachments and counts."
          }
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare sprint demo\",\n  \"description\": \"Slides + live demo\",\n  \"status\": \"todo\",\n  \"priority\": \"high\",\n  \"assigned_user_id\": 2,\n  \"due_date\": \"2026-10-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Only `title` is required. Returns 201."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data) pm.collectionVariables.set('task_id', b.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Partial update. Allowed for creator, assignee or admin (else 403)."
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}"
              ]
            },
            "description": "Creator or admin. Returns 204 and removes attachment files."
          }
        }
      ]
    },
    {
      "name": "Attachments",
      "item": [
        {
          "name": "Upload attachment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}/attachments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}",
                "attachments"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "description": "Up to 20 MB in one request. Re-uploading the same file name to the same task creates the next version. The response has scan_status = pending; the scan and thumbnail run on the queue."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.data) pm.collectionVariables.set('attachment_id', b.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Download attachment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attachments/{{attachment_id}}/download",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "attachments",
                "{{attachment_id}}",
                "download"
              ]
            },
            "description": "Returns the file with its original name. 423 while the virus scan is still running, 410 if the file was quarantined."
          }
        },
        {
          "name": "Attachment thumbnail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attachments/{{attachment_id}}/thumbnail",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "attachments",
                "{{attachment_id}}",
                "thumbnail"
              ]
            },
            "description": "320px WebP preview for images. 404 until the GenerateThumbnail job has run (or for non-images)."
          }
        },
        {
          "name": "Attachment versions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attachments/{{attachment_id}}/versions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "attachments",
                "{{attachment_id}}",
                "versions"
              ]
            },
            "description": "Every version of this file within its task, newest first."
          }
        },
        {
          "name": "Delete attachment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attachments/{{attachment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "attachments",
                "{{attachment_id}}"
              ]
            },
            "description": "Same permission as updating the task. Returns 204."
          }
        }
      ]
    },
    {
      "name": "Chunked upload",
      "description": "For files over 20 MB (up to 500 MB). Start the upload, send each 5 MB chunk with its index, then complete. In Postman, select a chunk file (a slice of the original) for each Send chunk call; the frontend slices files automatically.",
      "item": [
        {
          "name": "Start chunked upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}/attachments/chunked",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}",
                "attachments",
                "chunked"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_name\": \"big-video.mp4\",\n  \"file_size\": 62914560\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns upload_id, chunk_size (5 MB) and total_chunks. The upload_id is stored in the collection variable automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.upload_id) pm.collectionVariables.set('upload_id', body.upload_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send chunk",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/uploads/{{upload_id}}/chunks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "uploads",
                "{{upload_id}}",
                "chunks"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "index",
                  "value": "0",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "description": "index is 0-based. Re-sending the same index overwrites it, so a failed chunk can simply be retried."
          }
        },
        {
          "name": "Complete chunked upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/uploads/{{upload_id}}/complete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "uploads",
                "{{upload_id}}",
                "complete"
              ]
            },
            "description": "Assembles the chunks, validates the real file type and size, and creates the attachment (versioning, scan and thumbnail as for a normal upload). 422 lists missing chunks."
          }
        },
        {
          "name": "Abort chunked upload",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/uploads/{{upload_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "uploads",
                "{{upload_id}}"
              ]
            },
            "description": "Discards the stored chunks."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "List comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}/comments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}",
                "comments"
              ]
            }
          }
        },
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}/comments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasks",
                "{{task_id}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Looks good, merging today.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Compact list for assignee dropdowns."
          }
        }
      ]
    },
    {
      "name": "Realtime",
      "description": "WebSocket channels are served by Laravel Reverb (ws://localhost:8080). Laravel Echo calls this endpoint to authorise private and presence channels with the same JWT.",
      "item": [
        {
          "name": "Authorize channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/broadcasting/auth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "broadcasting",
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"socket_id\": \"1234.5678\",\n  \"channel_name\": \"private-task.{{task_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Channels: private-tasks, private-task.{id}, private-App.Models.User.{id}, presence-online, presence-task-viewers.{id}. Returns {auth} (and channel_data for presence channels), or 403."
          }
        }
      ]
    }
  ]
}
